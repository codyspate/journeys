    "node-simconnect": "^4.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "^6.0.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
